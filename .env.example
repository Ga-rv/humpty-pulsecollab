# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pulsecollab?retryWrites=true&w=majority

# Gemini API Key for Pulse Synthesis (Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration (optional)
PORT=3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Pusher Real-Time WebSockets (Vercel & Serverless compatible)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster
